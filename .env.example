# Alpaca Trading API Credentials
# Paper Trading is strictly enforced. Live trading keys will be rejected.
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here
ALPACA_PAPER_TRADE=true

# Strategy Settings
IV_RANK_FLOOR=30.0
MIN_SHORT_DELTA=-0.20
MAX_SHORT_DELTA=-0.15
SPREAD_WIDTH=5.0
MAX_CONCURRENT_SPREADS=2
MAX_ACCOUNT_RISK_PCT=0.05
MAX_SPREAD_RISK_PCT=0.02
TAKE_PROFIT_PCT=0.50
STOP_LOSS_PCT=2.00

# Server & Runner Settings
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
MOCK_ALPACA=false
